# KONSÜL AI — deploy ortam değişkenleri
# VPS'te docker-compose.yml sabit değerleri kullanır; bu dosya PaaS (Railway/Render/Fly)
# için kopyala-yapıştır referansıdır.

# Dışa bağlan (PaaS genelde zaten 0.0.0.0 bekler)
KONSUL_HOST=0.0.0.0

# Port — PaaS kendi PORT'unu verirse app otomatik onu kullanır (run.py)
KONSUL_PORT=8888

# DB dosyası — KALICI bir diske göster (PaaS: volume; VPS: compose volume'ü /data)
KONSUL_DB_PATH=/data/konsul.db

# YALNIZCA API'yi farklı bir origin'den kullanacaksan aç (genelde boş bırak = kapalı, güvenli)
# KONSUL_CORS_ORIGINS=https://ornek.com

# YALNIZCA model sunucusu KONSÜL'le AYNI makinedeyse (lokal LLM) — bulut LLM kullanıyorsan gereksiz
# KONSUL_LOCAL_PORTS=11434,1234,20128
